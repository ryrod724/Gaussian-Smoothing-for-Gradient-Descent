import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import minimize_scalar # type: ignore
from mpl_toolkits.mplot3d import Axes3D   # type: ignore # noqa: F401 (needed for projection='3d')
import time

# ══════════════════════════════════════════════════════════════════════════════
#  PARAMETERS
# ══════════════════════════════════════════════════════════════════════════════
a         = 0.001    # a > 0: controls tilt, depth asymmetry between wells (only defined for |a|<8/(3sqrt3) ~ 1.5396)
n         = 50      # number of random starting points per method
dx        = 0.005   # step size, traditional GD
eta_theta = 0.005   # step size for theta, smoothed GD
eta_sigma = 5e-4    # step size for sigma, smoothed GD
sigma0    = 1.5     # initial smoothing width (should be ~distance between minima)
N_mc      = 500     # Monte Carlo samples per iteration
max_it    = 3000    # maximum iterations before giving up
tol       = 1e-4    # convergence criterion: ||grad_f(theta)|| < tol
sigma_min = 0.01    # sigma floor: prevents sigma collapsing to 0 in finite time
hit_r     = 0.01    # radius around global min for declaring success
n_plot    = 10       # number of trajectories to display on contour plots

print("=" * 60)
print("PARAMETER CHECKS")
print("=" * 60)
print(f"[CHECK] a = {a}  (must be > 0)")                                                 
print(f"[CHECK] n = {n}, max_it = {max_it}, tol = {tol}")                                
print(f"[CHECK] dx = {dx}, eta_theta = {eta_theta}, eta_sigma = {eta_sigma}")           
print(f"[CHECK] sigma0 = {sigma0}, sigma_min = {sigma_min}, N_mc = {N_mc}")               
assert a > 0,         "a must be positive"
assert sigma0 > 0,    "sigma0 must be positive"
assert sigma_min > 0, "sigma_min must be positive"
assert sigma_min < sigma0, "sigma_min must be less than sigma0"

# ══════════════════════════════════════════════════════════════════════════════
#  ANALYTIC FUNCTIONS
#
#  f(x,y) = (1 - x^2)^2 + y^2 + a*x
#
#  grad f  = [df/dx, df/dy]
#           = [4x^3 - 4x + a,  2y]
#
#  Laplacian of f (nabla^2 f = d^2f/dx^2 + d^2f/dy^2):
#    d^2f/dx^2 = 12x^2 - 4
#    d^2f/dy^2 = 2
#    => nabla^2 f = 12x^2 - 2
#
#  Note: nabla2_f accepts vectorised arrays (shape (N_mc,)) for fast MC.
# ══════════════════════════════════════════════════════════════════════════════
def f_eval(x, y):
    return (1 - x**2)**2 + y**2 + a * x

def grad_f(p):
    """Gradient of f at point p = [x, y]. Returns shape (2,)."""
    return np.array([4*p[0]**3 - 4*p[0] + a,
                     2*p[1]])

def nabla2_f(x, y):
    """Laplacian of f: sum of unmixed second partials. Vectorised over x, y."""
    return 12*x**2 - 2

print("\n" + "=" * 60)
print("ANALYTIC FUNCTION CHECKS")
print("=" * 60)
print(f"[CHECK] f(0,0)  = {f_eval(0,0):.4f}  (expected: 1.0  since (1-0)^2 + 0 + 0 = 1)")            
print(f"[CHECK] f(-1,0) = {f_eval(-1,0):.4f}  (expected: {-a:.4f} since (1-1)^2 + 0 + a*(-1) = -a)")  
print(f"[CHECK] f(1,0)  = {f_eval(1,0):.4f}   (expected: {a:.4f}  since (1-1)^2 + 0 + a*(1)  =  a)")  
print(f"[CHECK] f(0,1)  = {f_eval(0,1):.4f}   (expected: 2.0  since 1 + 1 + 0 = 2)")                  

g_origin = grad_f(np.array([0.0, 0.0]))
g_at_1   = grad_f(np.array([1.0, 0.0]))
g_at_m1  = grad_f(np.array([-1.0, 0.0]))
print(f"[CHECK] grad_f([0,0])  = {g_origin}  (expected: [{a}, 0] since 0 - 0 + a = a)")              
print(f"[CHECK] grad_f([1,0])  = {g_at_1}   (expected: [{a}, 0] since 4 - 4 + a = a; NOT a min for a≠0)")  
print(f"[CHECK] grad_f([-1,0]) = {g_at_m1}  (expected: [{a}, 0] since -4+4+a = a; NOT a min for a≠0)")     

lap_origin = nabla2_f(0.0, 0.0)
lap_at_1   = nabla2_f(1.0, 0.0)
lap_at_2   = nabla2_f(2.0, 0.0)
print(f"[CHECK] nabla2_f(0,0) = {lap_origin:.1f}  (expected: -2.0; negative => oscillatory at origin)")  
print(f"[CHECK] nabla2_f(1,0) = {lap_at_1:.1f} (expected: 10.0; positive => convex near x=1)")            
print(f"[CHECK] nabla2_f(2,0) = {lap_at_2:.1f} (expected: 46.0)")                                      

# ══════════════════════════════════════════════════════════════════════════════
#  TRUE MINIMA  (scipy replaces MATLAB fminbnd)
#  Minimise over y=0 slice; y-coordinate is trivially 0 at any minimum.
# ══════════════════════════════════════════════════════════════════════════════
f1d       = lambda xv: (1 - xv**2)**2 + a * xv
res_glob  = minimize_scalar(f1d, bounds=(-2.5, 0.0), method='bounded')
res_loc   = minimize_scalar(f1d, bounds=( 0.0, 2.5), method='bounded')

x_glob, fv_glob = res_glob.x, res_glob.fun
x_loc,  fv_loc  = res_loc.x,  res_loc.fun
p_glob = np.array([x_glob, 0.0])
p_loc  = np.array([x_loc,  0.0])

print("\n" + "=" * 60)
print("MINIMA CHECKS")
print("=" * 60)
print(f"Global min: ({x_glob:.6f}, 0),  f = {fv_glob:.6f}")
print(f"Local  min: ({x_loc:.6f},  0),  f = {fv_loc:.6f}")

grad_at_glob = grad_f(p_glob)
grad_at_loc  = grad_f(p_loc)
print(f"[CHECK] ||grad_f|| at global min = {np.linalg.norm(grad_at_glob):.2e}  (must be ~0)")                       
print(f"[CHECK] ||grad_f|| at local  min = {np.linalg.norm(grad_at_loc):.2e}   (must be ~0)")                       
print(f"[CHECK] fv_glob < fv_loc? {fv_glob:.4f} < {fv_loc:.4f} => {fv_glob < fv_loc}  (must be True for a > 0)")  
print(f"[CHECK] x_glob in (-2.5, 0)? {-2.5 < x_glob < 0}  (must be True)")                                         
print(f"[CHECK] x_loc  in ( 0,  2.5)? {0 < x_loc < 2.5}   (must be True)")                                        
print(f"[CHECK] nabla2_f at global min = {nabla2_f(x_glob, 0):.4f}  (must be > 0: convex at min)")                  
print(f"[CHECK] nabla2_f at local  min = {nabla2_f(x_loc,  0):.4f}  (must be > 0: convex at min)")                  
assert fv_glob < fv_loc,           "Global min must have lower f value than local min"
assert np.linalg.norm(grad_at_glob) < 1e-4, "Gradient at global min must be ~0 (solver precision)"
assert np.linalg.norm(grad_at_loc)  < 1e-4, "Gradient at local min must be ~0 (solver precision)"

# ══════════════════════════════════════════════════════════════════════════════
#  GRID FOR SURFACE AND CONTOUR PLOTS
# ══════════════════════════════════════════════════════════════════════════════
x_range = np.linspace(-2, 2, 120)
y_range = np.linspace(-2, 2, 120)
Xg, Yg  = np.meshgrid(x_range, y_range)
Zg      = f_eval(Xg, Yg)

print("\n" + "=" * 60)
print("GRID CHECKS")
print("=" * 60)
print(f"[CHECK] Xg shape = {Xg.shape}  (expected: (120, 120))")                                                     
print(f"[CHECK] Zg shape = {Zg.shape}  (expected: (120, 120))")                                                      
# Centre of grid is (x=0, y=0), Xg[60,60] and Yg[60,60] should be ~0
print(f"[CHECK] Xg[60,60] = {Xg[60,60]:.4f}, Yg[60,60] = {Yg[60,60]:.4f}  (expected: ~0, ~0)")                    
print(f"[CHECK] Zg[60,60] = {Zg[60,60]:.4f}  (expected: ~f(0,0) = 1.0)")                                           
print(f"[CHECK] Zg.min()  = {Zg.min():.4f}   (expected: ~fv_glob = {fv_glob:.4f})")                                
print(f"[CHECK] Zg.max()  = {Zg.max():.4f}")                                                                        

# ══════════════════════════════════════════════════════════════════════════════
#  SHARED RANDOM STARTING POINTS  (seed fixed for reproducibility)
# ══════════════════════════════════════════════════════════════════════════════
np.random.seed(42)
points = (np.random.rand(2, n) - 0.5) * 4    # uniform on [-2, 2]^2

print("\n" + "=" * 60)
print("STARTING POINTS CHECKS")
print("=" * 60)
print(f"[CHECK] points shape = {points.shape}  (expected: (2, {n}))")                                               
print(f"[CHECK] points range: [{points.min():.3f}, {points.max():.3f}]  (must be within [-2, 2])")                  
print(f"[CHECK] points mean  = {points.mean():.3f}  (expected: ~0 for n=50)")                                      
assert points.min() >= -2 and points.max() <= 2, "Starting points out of domain"

colors = plt.cm.tab10(np.linspace(0, 0.9, n_plot))

# ══════════════════════════════════════════════════════════════════════════════
#  TRADITIONAL GRADIENT DESCENT
#
#    theta_{k+1} = theta_k - dx * grad_f(theta_k)
#
#  Converges when ||grad_f(theta_k)|| < tol.
# ══════════════════════════════════════════════════════════════════════════════
print("\n" + "=" * 60)
print("TRADITIONAL GD")
print("=" * 60)

trad_steps = []
trad_times = []

trad_hits  = 0
trad_trajs = [None] * n_plot
f_trad_trial0 = []   # f values along trial 0 for monotone check

for i in range(n):
    curr = points[:, i].copy()
    if i < n_plot:
        traj = [curr.copy()]
    if i == 0:
        f_trad_trial0.append(float(f_eval(curr[0], curr[1])))

    t_start = time.time()

    for j in range(max_it):
        g    = grad_f(curr)
        curr = curr - dx * g
        if i < n_plot:
            traj.append(curr.copy())
        if i == 0:
            f_trad_trial0.append(float(f_eval(curr[0], curr[1])))
        if np.linalg.norm(g) < tol:
            trad_steps.append(j + 1)
            break
    else:
        trad_steps.append(max_it)
    
    t_end = time.time()
    trad_times.append(t_end - t_start)
    
    if i < n_plot:
        trad_trajs[i] = np.array(traj)
    if np.linalg.norm(curr - p_glob) < hit_r:
        trad_hits += 1

f_trad_arr   = np.array(f_trad_trial0)
is_decreasing = np.all(np.diff(f_trad_arr) <= 1e-8)
print(f"[CHECK] trad_hits = {trad_hits}/{n} ({100*trad_hits/n:.0f}%) reached global min")               
print(f"\nTraditional GD: {trad_hits}/{n} ({100*trad_hits/n:.0f}%) reached global min")

# ══════════════════════════════════════════════════════════════════════════════
#  ISOTROPIC SMOOTHED GRADIENT DESCENT
#
#  Jointly minimises g(Sigma, theta) = int f(theta-theta') G_Sigma(theta') dtheta'
#  with Sigma = sigma^2 I, over both theta and sigma simultaneously.
#
#  From the derivation via Stein's Lemma:
#
#    nabla_theta g = E_{z ~ N(0, sigma^2 I)}[ grad f(theta + z) ]
#    nabla_sigma g = sigma * E_{z ~ N(0, sigma^2 I)}[ nabla^2 f(theta + z) ]
#
#  Coupled update (Euler discretisation):
#    theta_{k+1} = theta_k - eta_theta * nabla_theta g
#    sigma_{k+1} = max( sigma_k - eta_sigma * nabla_sigma g,  sigma_min )
#
#  Physical interpretation of sigma dynamics:
#    Near a true minimum:    nabla^2 f > 0  =>  dot_sigma < 0  (smoothing decreases)
#    In oscillatory valley:  nabla^2 f < 0  =>  dot_sigma > 0  (smoothing increases to escape)
#
#  Both expectations approximated by Monte Carlo with N_mc samples each step.
# ══════════════════════════════════════════════════════════════════════════════
print("\n" + "=" * 60)
print("SMOOTHED GD")
print("=" * 60)

smooth_steps = []
smooth_times = []

smooth_hits  = 0
smooth_trajs = [None] * n_plot
sigma_trace  = np.full((n, max_it + 1), sigma_min)  # sigma values for all trials
mc_checked   = False

for i in range(n):
    curr  = points[:, i].copy()
    sigma = sigma0
    if i < n_plot:
        traj = [curr.copy()]

    sigma_trace[i, 0] = sigma0

    t_start = time.time()

    for j in range(max_it):

        # Sample z_1, ..., z_{N_mc}  ~  N(0, sigma^2 I_2)
        Z  = sigma * np.random.randn(2, N_mc)   # shape (2, N_mc)
        Px = curr[0] + Z[0, :]                  # perturbed x coords, shape (N_mc,)
        Py = curr[1] + Z[1, :]                  # perturbed y coords, shape (N_mc,)

        # nabla_theta g ~= (1/N_mc) sum_k grad f(theta + z_k)
        grad_g   = np.array([np.mean(4*Px**3 - 4*Px + a),
                              np.mean(2*Py)])

        # nabla_sigma g ~= sigma * (1/N_mc) sum_k nabla^2 f(theta + z_k)
        grad_sig = sigma * np.mean(nabla2_f(Px, Py))

        # Coupled gradient descent updates
        curr  = curr  - eta_theta * grad_g
        sigma = max(sigma - eta_sigma * grad_sig, sigma_min)

        if i < n_plot:
            traj.append(curr.copy())

        sigma_trace[i, j + 1] = sigma

        if np.linalg.norm(grad_f(curr)) < tol:
            # Pad remaining iterations with final sigma value (for plotting)
            sigma_trace[i, j + 1:] = sigma
            smooth_steps.append(j + 1)
            break
    else:
        smooth_steps.append(max_it)

    t_end = time.time()
    smooth_times.append(t_end - t_start) 

    if i < n_plot:
        smooth_trajs[i] = np.array(traj)
    if np.linalg.norm(curr - p_glob) < hit_r:
        smooth_hits += 1

# Calculate the ensemble mean across all trials for the plot data
mean_sigma = np.mean(sigma_trace, axis=0)

print(f"[CHECK] sigma_trace matrix shape = {sigma_trace.shape}  (trials, iterations)")                      
print(f"[CHECK] Ensemble mean min sigma  = {np.min(mean_sigma):.6f}")                                           
print(f"[CHECK] Ensemble mean max sigma  = {np.max(mean_sigma):.6f}")                                       
print(f"[CHECK] Every element >= min?    = {np.all(sigma_trace >= sigma_min)}")                            


print(f"[CHECK] smooth_trajs[0] shape = {smooth_trajs[0].shape}  (rows=iterations+1, cols=2)")                   
print(f"[CHECK] smooth_hits = {smooth_hits}/{n} ({100*smooth_hits/n:.0f}%) reached global min")                  
print(f"\nSmoothed GD: {smooth_hits}/{n} ({100*smooth_hits/n:.0f}%) reached global min")

# steps until convergence for each method
avg_trad_steps = np.mean(trad_steps)
avg_smooth_steps = np.mean(smooth_steps)

print(f"Traditional GD Average Steps to Converge: {avg_trad_steps:.1f}")
print(f"Smoothed GD Average Steps to Converge:    {avg_smooth_steps:.1f}")

# ══════════════════════════════════════════════════════════════════════════════
#  FIGURE 1: SURFACE + CONTOUR TRAJECTORY COMPARISON
# ══════════════════════════════════════════════════════════════════════════════
fig = plt.figure(figsize=(18, 5))

# --- Panel 1: 3D surface ---
ax1 = fig.add_subplot(1, 3, 1, projection='3d')
ax1.plot_surface(Xg, Yg, Zg, alpha=0.75, edgecolor='none', cmap='viridis')
ax1.scatter([x_glob], [0], [fv_glob], color='lime', s=120, zorder=5, label='Global min')
ax1.scatter([x_loc],  [0], [fv_loc],  color='red',  s=120, zorder=5, label='Local min')
ax1.set_xlim([-2, 2]); ax1.set_ylim([-2, 2]); ax1.set_zlim([-3, 5])
ax1.set_xlabel('x'); ax1.set_ylabel('y'); ax1.set_zlabel('f(x,y)')
ax1.set_title(f'f(x,y),  a = {a}')
ax1.legend()

# --- Panels 2 & 3: contour + trajectories ---
all_trajs  = [trad_trajs,       smooth_trajs]
all_titles = ['Traditional GD', 'Smoothed GD']
all_hits   = [trad_hits,        smooth_hits]

for k in range(2):
    ax = fig.add_subplot(1, 3, k + 2)
    cp = ax.contourf(Xg, Yg, Zg, 25, cmap='viridis')
    plt.colorbar(cp, ax=ax)
    ax.plot(x_glob, 0, 'g*', markersize=14, label='Global min', zorder=5)
    ax.plot(x_loc,  0, 'r*', markersize=14, label='Local min',  zorder=5)

    for i in range(n_plot):
        tr = all_trajs[k][i]
        ax.plot(tr[:, 0], tr[:, 1], '-',  color=colors[i], linewidth=1.2)
        ax.plot(tr[0, 0], tr[0, 1], 'o',  color=colors[i], markersize=7,
                markerfacecolor=colors[i])                          # circle = start
        ax.plot(tr[-1,0], tr[-1,1], 's',  color=colors[i], markersize=7,
                markerfacecolor='white', markeredgewidth=1.5)       # square = end

    ax.set_xlim([-2, 2]); ax.set_ylim([-2, 2])
    ax.set_xlabel('x'); ax.set_ylabel('y')
    ax.set_title(f'{all_titles[k]}  ({all_hits[k]} / {n} → global)')
    ax.legend(loc='lower right')

plt.tight_layout()
plt.savefig('/Users/ryanrodrigue/Desktop/smoothed_gd_comparison.png', dpi=150, bbox_inches='tight')
print("\n[CHECK] Figure 1 saved as smoothed_gd_comparison.png")    
plt.show()

# ══════════════════════════════════════════════════════════════════════════════
#  FIGURE 2: SIGMA EVOLUTION (trial 0)
#  Physical expectation:
#   - Starts at sigma0 = 1.5
#   - Should DECREASE near a minimum (nabla^2 f > 0 => dot_sigma < 0)
#   - May briefly INCREASE if theta passes through oscillatory region
#   - Floored at sigma_min (never collapses to 0)
# ══════════════════════════════════════════════════════════════════════════════
avg_trad_time = np.mean(trad_times)
avg_smooth_time = np.mean(smooth_times)

print(f"Traditional GD Average Execution Time Per Trial: {avg_trad_time:.4f} seconds")
print(f"Smoothed GD Average Execution Time Per Trial:    {avg_smooth_time:.4f} seconds")

mean_sigma_trace = np.mean(sigma_trace, axis=0)  # average over all trials
fig2, ax2 = plt.subplots(figsize=(8, 4))
ax2.plot(range(max_it + 1), mean_sigma_trace, 'b-', linewidth=2, label=r'Ensemble Average $\mu_{\sigma}(t)$')


ax2.axhline(sigma_min, color='red', linestyle='--', linewidth=1.2, label=r'$\sigma_{\min}$')
ax2.axhline(sigma0,    color='gray', linestyle=':',  linewidth=1.0, label=r'$\sigma_0$')
ax2.set_xlabel('Iteration')
ax2.set_ylabel(r'$\sigma$')
ax2.set_title(f'σ(t),  a = {a}')
ax2.axvline(x=avg_smooth_steps, color='purple', linestyle='--', linewidth=1.5, 
            label=f'Avg Steps to Converge ({avg_smooth_steps:.1f})')
ax2.legend()
ax2.grid(True)
plt.tight_layout()
plt.savefig('/Users/ryanrodrigue/Desktop/sigma_trace.png', dpi=150, bbox_inches='tight')
print("[CHECK] Figure 2 saved as sigma_trace.png")  
